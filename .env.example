# Local dev: leave NUXT_PUBLIC_API_BASE unset — apiBase defaults to the
# same-origin proxy path `/__backend` (avoids the backend CORS allowlist not
# including localhost). Set NUXT_PROXY_TARGET to the backend the proxy forwards
# to. In production (Vercel), set NUXT_PUBLIC_API_BASE to the real backend URL.
NUXT_PROXY_TARGET=https://demo-umu-backend-production.up.railway.app
# NUXT_PUBLIC_API_BASE=https://your-backend-url
NUXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token_here
NUXT_PUBLIC_OS_API_KEY=your_os_api_key_here
# Server only, never NUXT_PUBLIC_. Lets UMU (the passport assistant) understand
# spoken answers its own matching can't place, via server/api/umu-understand.
# Without it UMU works as before, with its built-in matching only.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
